{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/onedayonemasterpiece/geo-reminder/blob/main/config/rules.schema.json",
  "title": "Geo Reminder local rules",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rules"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": ["string", "null"], "format": "date-time"},
    "rules": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "message", "zones"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "title": {"type": "string", "minLength": 1, "maxLength": 120},
          "message": {"type": "string", "minLength": 1, "maxLength": 1000},
          "enabled": {"type": "boolean", "default": true},
          "transition": {"enum": ["enter", "exit", "dwell"], "default": "enter"},
          "repeat": {"enum": ["once", "always"], "default": "once"},
          "cooldown_minutes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10080,
            "default": 0
          },
          "responsiveness_ms": {
            "type": "integer",
            "minimum": 60000,
            "maximum": 900000,
            "default": 120000
          },
          "dwell_ms": {
            "type": "integer",
            "minimum": 60000,
            "maximum": 3600000,
            "default": 120000
          },
          "valid_from": {"type": ["string", "null"], "format": "date-time"},
          "valid_until": {"type": ["string", "null"], "format": "date-time"},
          "source_text": {"type": ["string", "null"], "maxLength": 4000},
          "zones": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "latitude", "longitude", "radius_m"],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
                },
                "label": {"type": "string", "minLength": 1, "maxLength": 160},
                "latitude": {"type": "number", "minimum": -90, "maximum": 90},
                "longitude": {"type": "number", "minimum": -180, "maximum": 180},
                "radius_m": {"type": "number", "minimum": 75, "maximum": 2000}
              }
            }
          }
        }
      }
    }
  }
}
